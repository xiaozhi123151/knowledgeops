# Copy to .env. Never commit .env. Offline mode needs no provider credentials.
KO_MODE=offline
KO_LLM_PROVIDER=auto
KO_API_KEY=offline-local-only
KO_DATA_DIR=data

# Live LLM must support Chat Completions function tools (including tool_choice=required).
KO_LLM_BASE_URL=https://api.openai.com/v1
KO_LLM_API_KEY=
KO_LLM_MODEL=
# LLM selection is independent of local/server retrieval infrastructure.
# auto: offline->mock, live->openai. Explicit deepseek uses the official endpoint below.
# KO_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
KO_DEEPSEEK_BASE_URL=https://api.deepseek.com
KO_DEEPSEEK_MODEL=deepseek-flash
KO_DEEPSEEK_TEMPERATURE=0
# Optional separate LLM timeout; absent -> existing KO_TOOL_TIMEOUT behavior.
# KO_LLM_TIMEOUT=30
# Embedding configuration is independent. Dimensions MUST match the configured model response.
KO_EMBEDDING_BASE_URL=https://api.openai.com/v1
KO_EMBEDDING_API_KEY=
KO_EMBEDDING_MODEL=
KO_EMBEDDING_DIMENSIONS=1536
# Additive selectors: auto preserves offline/live defaults. Real local models need the models extra.
KO_EMBEDDING_PROVIDER=auto
KO_EMBEDDING_DEVICE=cpu
KO_EMBEDDING_BATCH_SIZE=8
KO_EMBEDDING_NORMALIZE=true
KO_EMBEDDING_MAX_LENGTH=512
# Pin immutable repository commits for repeatable real experiments.
# KO_EMBEDDING_MODEL=BAAI/bge-m3
# KO_EMBEDDING_DIMENSIONS=1024
# KO_EMBEDDING_REVISION=<40-character repository commit>
# KO_EMBEDDING_MODEL_PATH=data/models/bge-m3
KO_RERANKER_PROVIDER=auto
KO_MODEL_THREADS=8
KO_MODELS_LOCAL_ONLY=false
KO_MODEL_LOAD_TIMEOUT=600

KO_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
KO_RERANKER_DEVICE=cpu
KO_RERANKER_BATCH_SIZE=8
KO_RERANKER_MAX_LENGTH=512
# KO_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# KO_RERANKER_REVISION=<40-character repository commit>
# KO_RERANKER_MODEL_PATH=data/models/bge-reranker-v2-m3
KO_QDRANT_BACKEND=auto
KO_QDRANT_COLLECTION=knowledgeops_v1
KO_QDRANT_URL=http://qdrant:6333
KO_QDRANT_API_KEY=
KO_REDIS_URL=redis://redis:6379/0
KO_CHUNK_SIZE=800
KO_CHUNK_OVERLAP=120
KO_MAX_STEPS=12
KO_MAX_LLM_CALLS=8
KO_MAX_TOOL_CALLS=12
KO_MAX_SEARCH_CALLS=4
KO_TOKEN_BUDGET=20000
KO_OUTPUT_TOKENS=2000
KO_TASK_TIMEOUT=180
KO_TOOL_TIMEOUT=30
KO_MAX_RETRIES=2
KO_LEASE_SECONDS=30

# Optional metadata-only Langfuse trace. Install the trace extra when running outside Docker.
KO_LANGFUSE_PUBLIC_KEY=
KO_LANGFUSE_SECRET_KEY=
KO_LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional precision; CUDA experiments use float16 in a separate vector space.
KO_EMBEDDING_PRECISION=float32
KO_RERANKER_PRECISION=float32
